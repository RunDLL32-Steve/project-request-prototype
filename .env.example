PORT=3000

# --- Microsoft Entra SSO (leave blank + set DEV_AUTH=true for local dev) ---
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Admin area: only users holding this Entra app role (assigned in Enterprise applications)
ENTRA_ADMIN_ROLE=Admin
# Users need this role (or Admin) to submit requests
ENTRA_USER_ROLE=Default

# --- Local dev auth bypass (ignored when NODE_ENV=production) ---
DEV_AUTH=true
DEV_USER_NAME=Dev User
DEV_USER_EMAIL=dev.user@stsaviationgroup.com

# --- Storage: DynamoDB table (partition key projectId, Number). Blank = local JSON file in ./data ---
DDB_TABLE=
PREFS_TABLE=
# Required whenever DDB_TABLE is set (partition key auditPartition, sort key sortKey; both String)
AUDIT_TABLE=
AWS_REGION=us-east-1

# --- Notification email (SMTP). NOTIFY_TRANSPORT=none disables sending. ---
NOTIFY_TRANSPORT=none
NOTIFY_TO=rob.wire@stsaviationgroup.com
# Safety rail: when true, ALL notifications go only to NOTIFY_TEST_RECIPIENT
NOTIFY_TEST_MODE=true
NOTIFY_TEST_RECIPIENT=steven.millard@stsaviationgroup.com
NOTIFY_FROM_NAME=STS Technology Project Request
NOTIFY_FROM=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
WORKMAIL_PASSWORD=
